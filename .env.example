# Postgres. Locally: postgres://sprint:sprint@localhost:5434/sprint (docker compose up -d)
DATABASE_URL=
# Separate database for tests; tests that need it are skipped when it is empty
TEST_DATABASE_URL=

# Public URL of the app, used in login links (https://your-app.vercel.app)
APP_URL=http://localhost:3000

# Telegram bot from @BotFather
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram id (ask @userinfobot). Only this id can use the bot and log in.
OWNER_TELEGRAM_ID=
# Random string; Telegram sends it back so only Telegram can call the bot webhook
TELEGRAM_WEBHOOK_SECRET=
# Random string; the scheduler sends it so only it can trigger reminders
CRON_SECRET=
# Random string, 32+ characters; signs the login session cookie
SESSION_SECRET=

# Optional: Claude. Empty key = the app works without AI and hides the AI buttons.
ANTHROPIC_API_KEY=
# Input + output tokens per Kyiv calendar month for all Claude calls; 0 turns AI off.
AI_MONTHLY_TOKEN_CAP=2000000
