{
  "name": "sprint",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node --env-file-if-exists=.env.local --test --test-concurrency=1 \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env.local scripts/import-seed.ts",
    "bot:webhook": "node --env-file-if-exists=.env.local scripts/set-telegram-webhook.ts",
    "login-link": "node --env-file-if-exists=.env.local scripts/login-link.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "grammy": "^1.46.0",
    "next": "16.3.8",
    "postgres": "^3.4.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "drizzle-kit": "^0.31.11",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
